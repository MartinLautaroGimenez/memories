# Copiá este archivo a .env y ajustá los valores.

# URL pública con la que vas a entrar a Memories (sin barra final).
# Tiene que coincidir con la del navegador: se usa para los links compartidos y para proteger los formularios.
APP_URL=http://localhost:3000

# Otros orígenes desde los que se puede entrar (separados por coma), por ejemplo la IP de tu casa.
# TRUSTED_ORIGINS=http://192.168.0.10:3000

# Conexión a PostgreSQL.
DATABASE_URL=postgres://memories:memories@localhost:5432/memories

# Secreto para firmar sesiones y links. Generalo con: openssl rand -base64 32
AUTH_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# Carpeta donde se guardan las fotos (originales y versiones reducidas).
STORAGE_PATH=./data

# Tamaño máximo de cada foto subida, en megabytes.
MAX_UPLOAD_MB=200

# Cuántas fotos se procesan en paralelo.
PROCESS_CONCURRENCY=2
